    "Allowed Time in App:" : {

    },
    "As a student, I don’t earn much, and keeping apps available on the App Store comes with costs. If you enjoy using \"Be Strong, Stop Distraction\", I’d really appreciate your support!" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als Student verdiene ich nicht viel, und die Apps im App Store verfügbar zu halten, kostet Geld. Wenn dir „Be Strong, Stop Distraction“ gefällt, würde ich mich sehr über deine Unterstützung freuen!"
          }
        }
      }
    },
    "Automatically closes distracting apps after a customizable time limit. Starts a timer in the 'Be Strong, Stop Distraction' app, preventing you from reopening the distracting app until the timer finishes." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließt ablenkende Apps automatisch nach einer anpassbaren Zeitbegrenzung. Startet einen Timer in der „Be Strong, Stop Distraction“-App, der verhindert, dass du die ablenkende App wieder öffnest, bis der Timer abgelaufen ist."
          }
        }
      }
    },
    "Believe in yourself, %@!" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertraue in dich selbst, %@!"
