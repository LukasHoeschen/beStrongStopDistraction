    },
    "Strong Mode makes it hard to continue to the distracting App while the counter is still counting. Strong Mode is automatically active in Lockdown Mode." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Starke Modus erschwert es, die ablenkende App weiterhin zu nutzen, während der Timer noch läuft. Im Lockdown Modus ist der Starke Modus automatisch aktiviert."
          }
        }
      }
    },
