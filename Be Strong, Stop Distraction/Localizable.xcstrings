    },
    "You can now continue to %@." : {

    },
    "You can stay in %@ for a maximum of %@, then you need to wait for %@ before you can use it again. You need to stay at **Stop Distraction** until the Timer is done." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can stay in %1$@ for a maximum of %2$@, then you need to wait for %3$@ before you can use it again. You need to stay at **Stop Distraction** until the Timer is done."
          }
        }
      }
    },
    "You can use %@ for %@. Then you need to wait for %@ until you can use it again. No need to stay at **Stop Distraction** for this waiting time." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can use %1$@ for %2$@. Then you need to wait for %3$@ until you can use it again. No need to stay at **Stop Distraction** for this waiting time."
          }
        }
      }
    },
    "You can use %@ only three times a day for each five minutes." : {

    },
    "You can use %@, but after a given time you need to take a break till you can continue (60 Seconds, but active waiting)" : {

    },
    "You have %@ more times left to open %@ today." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You have %1$@ more times left to open %2$@ today."
          }
        }
      }
    },
    "You have %@ Sessions per Day. Meaning before using %@ you need to start a Session. Then you can use %@ for %@ until you need to start a new Session." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You have %1$@ Sessions per Day. Meaning before using %2$@ you need to start a Session. Then you can use %3$@ for %4$@ until you need to start a new Session."
          }
        }
      }
    },
    "You're stronger than any distraction, %@!" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist stärker als die Zeitfresser, %@!"
